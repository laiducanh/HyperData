PushButton, DropDownPushButton, ToolButton, TogglePushButton, ToggleToolButton {
    color: white;
    background: rgb(43, 43, 43);
    border: none;
    border-radius:8px;
    font: 15px;
    padding: 7px 12px 7px 12px;
    outline: none;
}

ToolButton[hasMenu=true] {
    padding: 5px 20px 6px 8px;
}

PushButton:hover, _DropDownPushButton:hover, ToolButton:hover, 
TogglePushButton:hover, ToggleToolButton:hover {
    background: rgba(220, 220, 220, 0.1);
    border: none;
}

PushButton:pressed, DropDownPushButton:pressed, ToolButton:pressed, TogglePushButton:pressed, ToggleToolButton:pressed {
    color: rgba(0, 0, 0, 0.63);
    background: rgba(220, 220, 220, 0.4);
    border: none;
}

PushButton:disabled, DropDownPushButton:disabled, ToolButton:disabled, TogglePushButton:disabled, ToggleToolButton:disabled {
    color: rgba(0, 0, 0, 0.36);
    background: rgba(249, 249, 249, 0.3);
}

TransparentPushButton, DropDownTransparentPushButton, TransparentToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    margin: 0;
}

TransparentPushButton:hover, DropDownTransparentPushButton:hover, TransparentToolButton:hover {
    background: rgba(220, 220, 220, 0.1);
    border: none;
}

TransparentPushButton:pressed, TransparentToolButton:pressed{
    color: rgba(0, 0, 0, 0.63);
    background: rgba(220, 220, 220, 0.4);
    border: none;
}

TransparentPushButton:disabled, DropDownTransparentPushButton:disabled, TransparentToolButton:disabled {
    background: transparent;
    border: none;
}

PrimaryPushButton, DropDownPrimaryPushButton, PrimaryToolButton,
TogglePushButton:checked, ToggleToolButton:checked {
    color: white;
    background-color: --THEMECOLOR-1.0;
    border: none;
}

PrimaryPushButton:hover, DropDownPrimaryPushButton:hover, PrimaryToolButton:hover,
TogglePushButton:checked:hover, ToggleToolButton:checked:hover {
    background-color: --THEMECOLOR-0.9;
    border: 2px solid --THEMECOLOR-1.0;
}

PrimaryPushButton:pressed, PrimaryToolButton:pressed,
TogglePushButton:checked:pressed, ToggleToolButton:checked:pressed {
    color: rgba(255, 255, 255, 0.63);
    background: --THEMECOLOR-0.6;
    border: none;
}

PrimaryPushButton:disabled, DropDownPrimaryPushButton:disabled, PrimaryToolButton:disabled,
TogglePushButton:checked:disabled, ToggleToolButton:checked:disabled {
    color: rgba(255, 255, 255, 0.63);
    background-color: --THEMECOLOR-0.3;
}

DropDownPushButton::menu-indicator,
DropDownPrimaryPushButton::menu-indicator,
DropDownTransparentPushButton::menu-indicator,
ToolButton::menu-indicator {
    image: url(ui:icons/white/ChevronDown_white.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: border;
    subcontrol-position: center right;
    margin: 0px;
    margin-right: 10px;
}

CheckBox {
    color: white;
    font: 15px;
    spacing: 8px;
    margin-left: 8px;
    margin-right: 8px;
    min-width: 28px;
    min-height: 20px;
}

CheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1.5px solid rgb(159, 159, 159);
    background-color: rgb(42, 42, 42);
}

CheckBox::indicator:hover {
    border: 1.5px solid rgb(161, 161, 161);
    background-color: rgb(56, 56, 56);
}

CheckBox::indicator:pressed {
    border: 1.5px solid rgb(86, 86, 86);
    background-color: rgb(62, 62, 62);
}

CheckBox::indicator:checked,
CheckBox::indicator:indeterminate {
    background-color: --THEMECOLOR-1.0;
    border: 1.5px solid --THEMECOLOR-1.0;
}

CheckBox::indicator:checked {
    image: url(ui:icons/black/accept.png);
}

CheckBox::indicator:indeterminate {
    image: url(ui:icons/black/partial_accept.svg);
}

CheckBox::indicator:checked:hover,
CheckBox::indicator:indeterminate:hover {
    border: 1.5px solid --THEMECOLOR-0.8;
    background-color: --THEMECOLOR-0.8;
}

CheckBox::indicator:checked:pressed,
CheckBox::indicator:indeterminate:pressed {
    border: 1.5px solid --THEMECOLOR-0.6;
    background-color: --THEMECOLOR-0.6;
}

CheckBox:disabled {
    color: rgba(255, 255, 255, 110);
}

CheckBox::indicator:disabled {
    border: 1.5px solid rgb(82, 82, 82);
    background-color: rgb(45, 45, 45);
}

CheckBox::indicator:checked:disabled,
CheckBox::indicator:indeterminate:disabled {
    border: 1.5px solid rgb(82, 82, 82);
    background-color: rgb(82, 82, 82);
}

RadioButton {
    min-height: 24px;
    max-height: 24px;
    background-color: transparent;
    font: 15px;
    color: white;
}

RadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 11px;
    border: 2px solid #848484;
    background-color: transparent;
    margin-right: 4px;
}

RadioButton::indicator:hover {
    background-color: rgba(255, 255, 255, 16);
}

RadioButton::indicator:pressed {
    border: 2px solid #434343;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(0, 0, 0),
            stop:0.5 rgb(0, 0, 0),
            stop:0.6 rgb(43, 42, 42),
            stop:1 rgb(43, 42, 42));
}

RadioButton::indicator:checked {
    height: 22px;
    width: 22px;
    border: none;
    border-radius: 11px;
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(0, 0, 0),
            stop:0.5 rgb(0, 0, 0),
            stop:0.6 --THEMECOLOR-1.0,
            stop:1 --THEMECOLOR-1.0);
}

RadioButton::indicator:checked:hover {
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(0, 0, 0),
            stop:0.6 rgb(0, 0, 0),
            stop:0.7 --THEMECOLOR-1.0,
            stop:1 --THEMECOLOR-1.0);
}

RadioButton::indicator:checked:pressed {
    background-color: qradialgradient(spread:pad, cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5,
            stop:0 rgb(0, 0, 0),
            stop:0.5 rgb(0, 0, 0),
            stop:0.6 --THEMECOLOR-1.0,
            stop:1 --THEMECOLOR-1.0);
}

RadioButton:disabled {
    color: rgb(150, 150, 150);
}

RadioButton::indicator:disabled {
    border: 2px solid #646464;
    background-color: transparent;
}
