ListWidget, TreeWidget {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding-right: 5px;
    padding-left: 5px;
}

ListWidget::item, TreeWidget::item {
    padding: 4px;
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 20px;
    color: black;
}

ListWidget::item:hover, TreeWidget::item:hover {
    background-color: rgba(222, 222, 222, 1);
}

ListWidget::item:selected, TreeWidget::item:selected {
    background-color: --THEMECOLOR-1.0;
    color: white;
}

QHeaderView, QHeaderView::section, QTableView QTableCornerButton::section {
	background: rgba(220, 220, 220, 0.8);
}

QHeaderView::section {
	color: rgba(67, 67, 67, 1);
	padding: 1ex;
}

QTableView::item {
	color: rgba(67, 67, 67, 1);
    background-color: white;
    border: none;
}

QTableView::item:selected {
	color: white;
	background-color: --THEMECOLOR-1.0;
}