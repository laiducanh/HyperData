PushButton, DropDownPushButton, ToolButton, TogglePushButton, ToggleToolButton {
    color: rgba(67, 67, 67, 1);
    background: white;
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius:8px;
    font: 15px;
    padding: 7px 12px 7px 12px;
    outline: none;
}

ToolButton[hasMenu=true] {
    padding: 5px 20px 6px 8px;
}

PushButton:hover, DropDownPushButton:hover, ToolButton:hover, 
TogglePushButton:hover, _ToggleToolButton:hover {
    background: rgba(220, 220, 220, 0.8);
}

PushButton:pressed, ToolButton:pressed, TogglePushButton:pressed, ToggleToolButton:pressed {
    color: rgba(67, 67, 67, 0.6);
    background: rgba(220, 220, 220, 0.4);
    border: 1px solid rgba(200, 200, 200, 0.8);
}

PushButton:disabled, ToolButton:disabled, TogglePushButton:disabled, ToggleToolButton:disabled {
    color: rgba(0, 0, 0, 0.36);
    background: rgba(249, 249, 249, 0.3);
    border: 1px solid rgba(0, 0, 0, 0.06);
}

TransparentPushButton, DropDownTransparentPushButton, TransparentToolButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    margin: 0;
}

CheckBox {
    text-align: left;
}

TransparentPushButton:hover, DropDownTransparentPushButton:hover, TransparentToolButton:hover,
CheckBox:hover {
    background: rgba(220, 220, 220, 0.8);
    border: none;
}

TransparentPushButton:pressed, TransparentToolButton:pressed, CheckBox:pressed {
    color: rgba(0, 0, 0, 0.63);
    background: rgba(220, 220, 220, 0.4);
    border: none;
}

TransparentPushButton:disabled, DropDownTransparentPushButton:disabled, 
TransparentToolButton:disabled, CheckBox:disabled {
    background: transparent;
    border: none;
}

PrimaryPushButton, DropDownPrimaryPushButton, PrimaryToolButton CheckBox:checked {
    color: white;
    background-color: --THEMECOLOR-1.0;
}

PrimaryPushButton:hover, DropDownPrimaryPushButton:hover, PrimaryToolButton:hover,
CheckBox:checked:hover {
    background-color: --THEMECOLOR-0.9;
    border: 2px solid --THEMECOLOR-1.0;
}

PrimaryPushButton:pressed, PrimaryToolButton:pressed,
TogglePushButton:checked:pressed, ToggleToolButton:checked:pressed, 
CheckBox:checked:pressed {
    color: rgba(255, 255, 255, 0.63);
}

PrimaryPushButton:disabled, DropDownPrimaryPushButton:disabled, PrimaryToolButton:disabled,
TogglePushButton:checked:disabled, ToggleToolButton:checked:pressed,
CheckBox:checked:disabled {
    color: rgba(255, 255, 255, 0.63);
    background-color: --THEMECOLOR-0.3;
}

TogglePushButton:checked, ToggleToolButton:checked {
    border: 2px solid --THEMECOLOR-1.0;
}

DropDownPushButton::menu-indicator,
DropDownTransparentPushButton::menu-indicator,
ToolButton::menu-indicator {
    image: url(ui:icons/black/ChevronDown_black.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: border;
    subcontrol-position: center right;
    margin: 0px;
    margin-right: 10px;
}

DropDownPrimaryPushButton::menu-indicator {
    image: url(ui:icons/white/ChevronDown_white.svg);
    width: 10px;
    height: 10px;
    subcontrol-origin: border;
    subcontrol-position: center right;
    margin: 0px;
    margin-right: 10px;
}

