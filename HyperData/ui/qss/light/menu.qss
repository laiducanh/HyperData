Menu {
    color: rgba(67, 67, 67, 1);
    background: white;
    border: 1px solid rgba(200, 200, 200, 0.8);
    /* border-radius: 8px; */
    font: 15px;
    padding: 4px 3px 4px 3px;
    outline: none;
}

Menu::right-arrow {
    width: 10px;
    height: 10px;
    right: 10px;
    border-image: url(ui:icons/black/ChevronRight_black.svg);
}

Menu::separator {
    height: 1px;
    background: rgba(200, 200, 200, 0.5);
    margin-top: 4px;
    margin-bottom: 4px;
}

Menu::item {
    color: rgba(67, 67, 67, 1);
    background: white;
    padding: 10px 30px 10px 20px;
    border-radius: 5px;
    border: none;
}

Menu::item:hover {
    border: 1px solid --THEMECOLOR-1.0;
}

Menu::item:selected {
    border: 1px solid --THEMECOLOR-1.0;
}

Menu::icon {
    padding-left: 20px;
}