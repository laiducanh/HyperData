QMainWindow, QMenuBar, QTableView, QAbstractTableModel, QGraphicsView {
    background-color:rgb(243, 243, 243);
    color:black;
}

QHeaderView, QHeaderView::section, QTableView QTableCornerButton::section {
	background: rgba(220, 220, 220, 0.8);
}

QHeaderView::section {
	color: rgba(67, 67, 67, 1);
	padding: 1ex;
}

QTableView::item {
	color: rgba(67, 67, 67, 1);
    background-color: white;
    border: none;
}

QTableView::item:selected {
	color: white;
	background-color: --THEMECOLOR-1.0;
}

QMainWindow::title {
    color: red;
}

NodeContentWidget {
    background: transparent;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border: none;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle {
    background: rgba(166, 166, 166, 1);
    border-radius: 4px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
}

QScrollBar::down-arrow, QScrollBar::up-arrow, QScrollBar::left-arrow, QScrollBar::right-arrow {
    border: none;
    background: none;
    color: none;
}