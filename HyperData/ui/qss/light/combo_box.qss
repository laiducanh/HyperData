ComboBox {
    border: 1px solid rgba(200, 200, 200, 0.8);
    border-radius: 8px;
    font: 15px;
    color: rgba(67, 67, 67, 1);
    background-color: white;
    text-align: left;
    selection-color: rgba(67, 67, 67, 1);
    padding: 7px 12px 7px 12px;
}

ComboBox:hover {
    background: rgba(220, 220, 220, 0.8);
}

PrimaryComboBox {
    background-color: --THEMECOLOR-1.0;
    color: white;
}

PrimaryComboBox:hover {
    background-color: --THEMECOLOR-0.9;
    border: 2px solid --THEMECOLOR-1.0;
}

TransparentComboBox {
    background-color: transparent;
    border: none;
}

TransparentComboBox:hover {
    border: 1px solid rgba(200, 200, 200, 0.8);
    background-color: rgba(220, 220, 220, 0.8);
}

ComboBox:disabled, PrimaryComboBox:disabled, TransparentComboBox:disabled {
    color: rgba(0, 0, 0, 0.36);
    background: rgba(249, 249, 249, 0.3);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
}

ComboBox::drop-down, PrimaryComboBox::drop-down, TransparentComboBox::drop-down {
    border: none;
    margin: 0px;
    margin-right: 17px;
    subcontrol-origin: padding;
    subcontrol-position: top right;
}

ComboBox::down-arrow, TransparentComboBox::down-arrow {
    image: url(ui:icons/black/ChevronDown_black.svg);
    width: 10px;
    height: 10px;
}

PrimaryComboBox::down-arrow {
    image: url(ui:icons/white/ChevronDown_white.svg);
    width: 10px;
    height: 10px;
}

ComboBox QAbstractItemView {
    border: 1px solid rgba(200, 200, 200, 0.8);
    /* border-radius: 8px; */
    background: white;
    padding: 4px 3px 4px 3px;
    outline: none;
}

ComboBox QAbstractItemView::item {
    color: rgba(67, 67, 67, 1);
    background: white;
    border-radius: 8px;
    padding: 7px 10px 7px 10px;
}

ComboBox QAbstractItemView::item:hover {
    background: rgba(220, 220, 220, 0.8);
    color: black;
}
